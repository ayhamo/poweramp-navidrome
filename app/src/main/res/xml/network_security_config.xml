<?xml version="1.0" encoding="utf-8"?>
<!-- Home servers are often plain http on the LAN (e.g. http://192.168.1.10:4533) -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
